{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:path+/assets/:file*",
      "destination": "/assets/:file*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
